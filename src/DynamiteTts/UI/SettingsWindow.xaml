<Window x:Class="DynamiteTts.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamiteTts.UI.Controls"
        Title="Dynamite TTS Settings"
        Height="720" Width="540"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/Resources/app_idle.ico"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="/Resources/app_idle.ico" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Dynamite TTS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Local Highlight-to-Speech Utility" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Section 1: Engine & Hardware Acceleration -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,16"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="TTS Engine &amp; Acceleration" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <Label Content="Inference Engine" Target="{Binding ElementName=EngineComboBox}" />
                        <ComboBox x:Name="EngineComboBox" Margin="0,0,0,10" SelectionChanged="OnEngineSelectionChanged">
                            <ComboBoxItem Content="Local Kokoro (In-Process — CPU, NVIDIA GPU via CUDA when available)" Tag="DirectML" IsSelected="True" />
                            <ComboBoxItem Content="Lemonade Server (HTTP Endpoint)" Tag="LemonadeServer" />
                        </ComboBox>

                        <!-- DirectML Configuration & Status Info -->
                        <StackPanel x:Name="DirectMlInfoPanel" Margin="0,0,0,4">
                            <Label Content="Hardware Acceleration" Target="{Binding ElementName=DirectMlDeviceComboBox}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="DirectMlDeviceComboBox" VerticalAlignment="Center" SelectionChanged="OnDirectMlDeviceChanged" />
                                <Button Grid.Column="1"
                                        x:Name="RefreshAdaptersButton"
                                        Content="Refresh"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="OnRefreshAdaptersClick" />
                            </Grid>

                            <Label Content="Model Precision" Target="{Binding ElementName=DirectMlPrecisionComboBox}" />
                            <ComboBox x:Name="DirectMlPrecisionComboBox" Margin="0,0,0,10">
                                <ComboBoxItem Content="FP32 (Full Precision — recommended; same speed as FP16 on CPU and CUDA)" Tag="float32" IsSelected="True" />
                                <ComboBoxItem Content="FP16 (Half Precision — smaller download only; FP32 is used whenever it is on disk)" Tag="float16" />
                            </ComboBox>

                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Ellipse x:Name="DirectMlStatusDot" Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DirectMlStatusTitle" Text="Local Kokoro engine is loading…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="DirectMlStatusDetails" Text="Synthesizes speech in-process on your own hardware via ONNX Runtime. Nothing leaves this machine." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Lemonade Server Panel (shown when LemonadeServer selected) -->
                        <StackPanel x:Name="LemonadeServerPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Label Content="Server Endpoint" Target="{Binding ElementName=EndpointTextBox}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EndpointTextBox" Text="http://localhost:13305/api/v1/audio/speech" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        x:Name="TestConnectionButton"
                                        Content="Test Connection"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="OnTestConnectionClick" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusTextBlock" Text="Checking connection..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Action bar when offline -->
                            <StackPanel x:Name="OfflineActionPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Lemonade Server is needed when using Server mode." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartServerButton"
                                            Content="Start Lemonade Server"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0"
                                            Click="OnStartServerClick" />
                                    <Button x:Name="InstallLemonadeButton"
                                            Content="Install Lemonade Server (winget)"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnInstallLemonadeClick" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 2: Model & Voice Settings -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,16"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Speech Model &amp; Voice" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <StackPanel x:Name="ModelSelectionContainer">
                            <Label Content="TTS Model" Target="{Binding ElementName=ModelComboBox}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModelComboBox" IsEditable="True" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        x:Name="RefreshModelsButton"
                                        Content="Refresh"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="OnRefreshModelsClick" />
                            </Grid>
                        </StackPanel>

                        <Label Content="Voice" Target="{Binding ElementName=VoiceComboBox}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="VoiceComboBox" IsEditable="True" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="PreviewVoiceButton"
                                    Content="Preview Voice"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnPreviewVoiceClick" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Speech Speed" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="SpeedValueTextBlock" Text="1.00x" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="SpeedSlider"
                                Minimum="0.25" Maximum="4.0"
                                Value="1.0"
                                SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="OnSpeedSliderValueChanged" />
                    </StackPanel>
                </Border>

                <!-- Section 3: Audio & System Integration -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Audio &amp; System" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <Label Content="Audio Output Device" Target="{Binding ElementName=AudioDeviceComboBox}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AudioDeviceComboBox" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="RefreshDevicesButton"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnRefreshDevicesClick" />
                        </Grid>

                        <Label Content="Global Shortcut (Highlight to Speak)" />
                        <controls:HotkeyCaptureBox x:Name="HotkeyCaptureControl" Margin="0,0,0,14" />

                        <CheckBox x:Name="PlaySoundOnStopCheckBox"
                                  Content="Play audio chime when stopping speech"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,10"
                                  Cursor="Hand" />
                        <CheckBox x:Name="ShowStatusBubbleCheckBox"
                                  Content="Show status bubble at the top of the screen while reading, synthesizing and speaking"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="13"
                                  Margin="0,0,0,10"
                                  Cursor="Hand" />

                        <CheckBox x:Name="LaunchAtStartupCheckBox"
                                  Content="Launch Dynamite TTS at Windows startup"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="13"
                                  Cursor="Hand" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Test / Stop Speech -->
                <Button Grid.Column="0"
                        x:Name="TestSpeechButton"
                        Content="Test Speech"
                        Style="{StaticResource SecondaryButton}"
                        Click="OnTestSpeechClick" />

                <!-- Speech Activity Indicator -->
                <StackPanel Grid.Column="1"
                            x:Name="SpeechActivityPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Visibility="Collapsed">
                    <Ellipse x:Name="SpeechActivityDot"
                             Width="8" Height="8"
                             Fill="{DynamicResource WarningBrush}"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="SpeechActivityTextBlock"
                               Text="Synthesizing speech..."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />

                <Button Grid.Column="3"
                        Content="Save Settings"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnSaveClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
