<Window x:Class="DynamiteTts.UI.StatusBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamite TTS status"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        Opacity="0"
        UseLayoutRounding="True">
    <!-- Outer margin leaves room for the drop shadow on a transparent window. -->
    <Grid Margin="16,4,16,20">
        <Border x:Name="Pill"
                Height="36"
                MinWidth="168"
                CornerRadius="18"
                Padding="14,0,6,0"
                Background="#F2181820"
                BorderBrush="#30FFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="18" Margin="0,0,10,0">
                    <Rectangle x:Name="Bar0" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#F3F4F6" />
                    <Rectangle x:Name="Bar1" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#F3F4F6" />
                    <Rectangle x:Name="Bar2" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#F3F4F6" />
                    <Rectangle x:Name="Bar3" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#F3F4F6" />
                    <Rectangle x:Name="Bar4" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#F3F4F6" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#F3F4F6"
                           Margin="0,0,10,0"
                           MaxWidth="280"
                           TextTrimming="CharacterEllipsis"
                           Text="Speaking" />

                <Button x:Name="StopButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Cursor="Hand"
                        ToolTip="Stop"
                        Click="OnStopClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#26FFFFFF" CornerRadius="12">
                                <Rectangle Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#F3F4F6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#EF4444" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
